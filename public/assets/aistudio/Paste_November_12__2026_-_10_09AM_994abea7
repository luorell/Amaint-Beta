<script>
  (function initExecutiveReport() {
    const btnPdf = document.getElementById('btn-export-pdf');
    const btnCsv = document.getElementById('btn-export-csv');
    const btnErp = document.getElementById('btn-sync-erp');
    const toast = document.getElementById('export-toast');
    const toastMsg = document.getElementById('toast-message');
    const inputSearch = document.getElementById('input-filtro-tabla');
    const tableRows = document.querySelectorAll('#tabla-costos-activos tbody tr');

    function showToast(text, duration = 3200) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = text;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, duration);
    }

    if (btnPdf) {
      btnPdf.addEventListener('click', () => {
        showToast('Exportando Reporte Ejecutivo Q1 2026 a PDF...');
      });
    }

    if (btnCsv) {
      btnCsv.addEventListener('click', () => {
        showToast('Descargando Dataframe Contable en Formato CSV...');
      });
    }

    if (btnErp) {
      btnErp.addEventListener('click', () => {
        showToast('Sincronizando Balance de Mantenimiento con SAP ERP...');
      });
    }

    if (inputSearch) {
      inputSearch.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        tableRows.forEach(row => {
          const rowText = row.textContent.toLowerCase();
          if (rowText.includes(query)) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    }
  })();
