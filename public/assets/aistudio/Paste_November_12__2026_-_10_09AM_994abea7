      });
      btn.className = 'severity-card text-left p-space-md rounded bg-surface-container-highest transition-all min-h-[64px] flex items-start gap-space-sm bg-gradient-to-r from-error-container/30 to-surface-container-high shadow-md';
    }

    function toggleChip(chip) {
      const isSelected = chip.classList.contains('bg-primary-container');
      const icon = chip.querySelector('.material-symbols-outlined');
      if (isSelected) {
        chip.classList.remove('bg-primary-container', 'text-on-primary-container', 'font-bold', 'shadow-sm');
        chip.classList.add('bg-surface-container-high', 'hover:bg-surface-bright', 'text-on-surface-variant', 'font-medium');
        icon.textContent = 'radio_button_unchecked';
      } else {
        chip.classList.remove('bg-surface-container-high', 'hover:bg-surface-bright', 'text-on-surface-variant', 'font-medium');
        chip.classList.add('bg-primary-container', 'text-on-primary-container', 'font-bold', 'shadow-sm');
        icon.textContent = 'check_circle';
      }
    }

    function toggleSwitch(toggle) {
      const isChecked = toggle.getAttribute('aria-checked') === 'true';
      const knob = toggle.querySelector('span');
      if (isChecked) {
        toggle.setAttribute('aria-checked', 'false');
        toggle.classList.remove('bg-error-container', 'justify-end');
        toggle.classList.add('bg-surface-container-highest', 'justify-start');
        knob.classList.remove('bg-on-error');
        knob.classList.add('bg-outline');
      } else {
        toggle.setAttribute('aria-checked', 'true');
        toggle.classList.add('bg-error-container', 'justify-end');
        toggle.classList.remove('bg-surface-container-highest', 'justify-start');
        knob.classList.add('bg-on-error');
        knob.classList.remove('bg-outline');
      }
    }

    let recording = false;
    function toggleVoiceRecording() {
      const label = document.getElementById('mic-label');
      const mic = document.getElementById('mic-icon');
      recording = !recording;
      if (recording) {
        label.textContent = 'Escuchando... Hable claramente al micrófono';
        label.classList.add('text-error');
        mic.classList.add('text-error');
      } else {
        label.textContent = 'Dictar Nota de Voz (Offline Speech Engine)';
        label.classList.remove('text-error');
        mic.classList.remove('text-error');
      }
    }

    function triggerSaveOffline() {
      const btn = event.currentTarget;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined text-2xl animate-spin">sync</span><span>Encriptando en Local (AES-256)...</span>';
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-2xl">check_circle</span><span>¡Guardado en Buffer IndexedDB!</span>';
        btn.classList.remove('bg-primary-container');
        btn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.add('bg-primary-container');
          btn.classList.remove('bg-tertiary-container', 'text-on-tertiary-container');
        }, 3000);
      }, 700);
    }

    function triggerEmergencyOT() {
      alert("Alerta: Se creará una Orden de Trabajo Prioridad 1 con parada de planta para el activo PL1-EXT-02. Notificación push enviada a Mantenimiento.");
    }
