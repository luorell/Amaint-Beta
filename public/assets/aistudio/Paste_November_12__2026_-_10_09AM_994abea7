<script>
  (function initIndustrialDashboard() {
    // 1. View switcher logic (Cards vs Dense Table)
    const btnViewCards = document.getElementById('btnViewCards');
    const btnViewDense = document.getElementById('btnViewDense');
    const workOrdersCardGrid = document.getElementById('workOrdersCardGrid');
    const workOrdersDenseTable = document.getElementById('workOrdersDenseTable');

    if (btnViewCards && btnViewDense && workOrdersCardGrid && workOrdersDenseTable) {
      btnViewCards.addEventListener('click', () => {
        workOrdersCardGrid.classList.remove('hidden');
        workOrdersDenseTable.classList.add('hidden');
        btnViewCards.classList.add('bg-surface-container-low', 'text-primary', 'shadow-sm');
        btnViewCards.classList.remove('text-on-surface-variant');
        btnViewDense.classList.remove('bg-surface-container-low', 'text-primary', 'shadow-sm');
        btnViewDense.classList.add('text-on-surface-variant');
      });

      btnViewDense.addEventListener('click', () => {
        workOrdersCardGrid.classList.add('hidden');
        workOrdersDenseTable.classList.remove('hidden');
        btnViewDense.classList.add('bg-surface-container-low', 'text-primary', 'shadow-sm');
        btnViewDense.classList.remove('text-on-surface-variant');
        btnViewCards.classList.remove('bg-surface-container-low', 'text-primary', 'shadow-sm');
        btnViewCards.classList.add('text-on-surface-variant');
      });
    }

    // 2. Interactive Status Filter Tabs
    const statusTabs = document.querySelectorAll('.status-tab');
    const cards = document.querySelectorAll('#workOrdersCardGrid article');

    statusTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        statusTabs.forEach(t => {
          t.classList.remove('bg-primary-container', 'text-on-primary-container');
          t.classList.add('bg-surface-container-high', 'text-on-surface-variant');
        });
        tab.classList.add('bg-primary-container', 'text-on-primary-container');
        tab.classList.remove('bg-surface-container-high', 'text-on-surface-variant');

        const filter = tab.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-status') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 3. Priority Filtering
    const priorityPills = document.querySelectorAll('.priority-pill');
    priorityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const priority = pill.getAttribute('data-priority');
        cards.forEach(card => {
          if (card.getAttribute('data-priority') === priority) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 4. Universal search input filter
    const searchInput = document.getElementById('searchInput');
    const btnFilterReset = document.getElementById('btnFilterReset');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase().trim();
        cards.forEach(card => {
          const text = card.textContent.toLowerCase();
          if (text.includes(term)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    if (btnFilterReset) {
      btnFilterReset.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        cards.forEach(card => card.style.display = 'flex');
        statusTabs.forEach((t, idx) => {
          if (idx === 0) {
            t.classList.add('bg-primary-container', 'text-on-primary-container');
            t.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
          } else {
            t.classList.remove('bg-primary-container', 'text-on-primary-container');
            t.classList.add('bg-surface-container-high', 'text-on-surface-variant');
          }
        });
      });
    }

    // 5. Force Sync Simulation (Offline Resilience feedback)
    const btnForzarSync = document.getElementById('btnForzarSync');
    const syncSpinner = document.getElementById('syncSpinner');
    const syncStaticIcon = document.getElementById('syncStaticIcon');

    if (btnForzarSync && syncSpinner && syncStaticIcon) {
      btnForzarSync.addEventListener('click', () => {
        syncStaticIcon.style.display = 'none';
        syncSpinner.style.display = 'inline-block';
        btnForzarSync.setAttribute('disabled', 'true');

        setTimeout(() => {
          syncSpinner.style.display = 'none';
          syncStaticIcon.style.display = 'inline-block';
          btnForzarSync.removeAttribute('disabled');
          alert('Sincronización Completa: 3 órdenes locales replicadas exitosamente en el servidor central de Planta Los Andes.');
        }, 1200);
      });
    }

    // 6. Detail Modal Interaction
    const detailModal = document.getElementById('otDetailModal');
    const modalOTCode = document.getElementById('modalOTCode');
    const modalAsset = document.getElementById('modalAsset');
    const btnCloseModal = document.getElementById('btnCloseModal');
    const btnCloseModalBottom = document.getElementById('btnCloseModalBottom');
    const detailButtons = document.querySelectorAll('.btn-card-detail');

    detailButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetOT = btn.getAttribute('data-target');
        if (modalOTCode) modalOTCode.textContent = targetOT;
        if (targetOT === 'OT-2026-089' && modalAsset) modalAsset.textContent = 'PL1-INJ-03 (Inyectora Hidráulica 03)';
        if (targetOT === 'OT-2026-092' && modalAsset) modalAsset.textContent = 'PL1-EXT-02 (Extrusora de Polímeros 02)';
        if (targetOT === 'OT-2026-095' && modalAsset) modalAsset.textContent = 'PL1-CHL-01 (Chiller Circuito A)';
        if (detailModal) {
          detailModal.classList.remove('hidden');
          detailModal.classList.add('flex');
        }
      });
    });

    const closeModal = () => {
      if (detailModal) {
        detailModal.classList.add('hidden');
        detailModal.classList.remove('flex');
      }
    };

    if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
    if (btnCloseModalBottom) btnCloseModalBottom.addEventListener('click', closeModal);
    if (detailModal) {
      detailModal.addEventListener('click', (e) => {
        if (e.target === detailModal) closeModal();
      });
    }

    // Keyboard shortcut (Shift + S for instant search focus)
    window.addEventListener('keydown', (e) => {
      if (e.shiftKey && (e.key === 'S' || e.key === 's')) {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      }
    });
  })();
</script></main></div></body></html>

