      // Save Specs Trigger
      const btnSave = document.getElementById('btn-save-specs');
      if (btnSave) {
        btnSave.addEventListener('click', () => {
          showIndustrialNotification(
            'Valores Originales Restaurados',
            'Ficha técnica sincronizada con la base de datos maestra.',
            'history'
          );
        });
      }

      // Quick Search input simulation
      const searchInput = document.getElementById('asset-tree-search');
      if (searchInput) {
        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
            searchInput.select();
          }
        });
      }
    })();
